{
  "manifest_version": 1,
  "id": "ytdlp",
  "version": "26.11.2",
  "display_name": "Videos from websites (yt-dlp)",
  "summary": "Opens the video of a web page from its link: YouTube, Vimeo and the many other websites yt-dlp knows. Keeps yt-dlp up to date by itself, as websites change. Use it only for videos you have the right to work on.",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-ytdlp",
  "license": "Apache-2.0",
  "executable": "bin/ytdlp-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows",
    "haiku"
  ],
  "haiku_packages": [
    "python3.14",
    "certifi_python3.14",
    "nodejs24"
  ],
  "tasks": [
    "media.download"
  ],
  "compute": "cpu",
  "models": [
    {
      "id": "yt-dlp",
      "display_name": "yt-dlp (updated by the add-on, about 3 MB)",
      "size_mb": 3,
      "license": "Unlicense",
      "bundled": true,
      "default": true,
      "url": "https://github.com/yt-dlp/yt-dlp"
    },
    {
      "id": "deno",
      "display_name": "Deno, for YouTube (downloaded once, when first needed)",
      "size_mb": 40,
      "license": "MIT",
      "bundled": false,
      "url": "https://github.com/denoland/deno"
    }
  ],
  "disk_required_mb": 150,
  "ram_required_mb": 256,
  "config_schema": {
    "fields": [
      {
        "key": "max_height",
        "type": "select",
        "label": "Largest video",
        "default": "1080",
        "help": "The tallest video to get, in pixels. Subtitling rarely needs more than 1080; a smaller video downloads faster.",
        "options": [
          {
            "value": "480",
            "label": "480p"
          },
          {
            "value": "720",
            "label": "720p"
          },
          {
            "value": "1080",
            "label": "1080p (Full HD)"
          },
          {
            "value": "1440",
            "label": "1440p"
          },
          {
            "value": "2160",
            "label": "2160p (4K)"
          },
          {
            "value": "best",
            "label": "The largest there is"
          }
        ]
      },
      {
        "key": "container",
        "type": "select",
        "label": "File type",
        "default": "mp4",
        "options": [
          {
            "value": "mp4",
            "label": "MP4"
          },
          {
            "value": "mkv",
            "label": "MKV"
          },
          {
            "value": "webm",
            "label": "WebM"
          }
        ],
        "help": "The kind of file the video is saved as. MKV takes any video and sound; when they don't fit in MP4 or WebM, the video is saved as MKV."
      },
      {
        "key": "video_codec",
        "type": "select",
        "label": "Video codec",
        "default": "h264",
        "options": [
          {
            "value": "h264",
            "label": "H.264 (plays everywhere)"
          },
          {
            "value": "any",
            "label": "Any, the best there is"
          },
          {
            "value": "av1",
            "label": "AV1"
          },
          {
            "value": "vp9",
            "label": "VP9"
          },
          {
            "value": "h265",
            "label": "H.265 (HEVC)"
          }
        ],
        "help": "The video codec to prefer. When the website has none in it, the best video there is is taken. Any takes the best whatever its codec, often AV1 or VP9, which some editors and older computers play less smoothly."
      },
      {
        "key": "audio_codec",
        "type": "select",
        "label": "Audio codec",
        "default": "aac",
        "options": [
          {
            "value": "aac",
            "label": "AAC (plays everywhere)"
          },
          {
            "value": "any",
            "label": "Any, the best there is"
          },
          {
            "value": "opus",
            "label": "Opus"
          }
        ],
        "help": "The audio codec to prefer. When the website has none in it, the best sound there is is taken."
      },
      {
        "key": "auto_update",
        "type": "bool",
        "label": "Keep yt-dlp up to date",
        "default": true,
        "help": "Once a day at most, fetch yt-dlp's latest release when the add-on is used. Websites change often, and an old yt-dlp may no longer get their videos."
      }
    ]
  }
}
